<IfModule mod_rewrite.c>

    RewriteEngine On
    RewriteBase /

    # Keamanan: blokir akses langsung ke file sensitif
    RewriteRule ^\.env - [F,L,NC]
    RewriteRule ^composer\.(json|lock) - [F,L,NC]
    RewriteRule ^package\.(json|lock) - [F,L,NC]
    RewriteRule ^artisan$ - [F,L,NC]
    RewriteRule ^server\.php$ - [F,L,NC]
    RewriteRule ^phpunit\.xml$ - [F,L,NC]

    # Blokir akses ke folder sensitif
    RewriteRule ^vendor/ - [F,L,NC]
    # RewriteRule ^storage/ - [F,L,NC] (Dihapus agar route /storage/ di Laravel bisa jalan)
    RewriteRule ^bootstrap/ - [F,L,NC]
    RewriteRule ^config/ - [F,L,NC]
    RewriteRule ^database/ - [F,L,NC]
    RewriteRule ^resources/ - [F,L,NC]
    RewriteRule ^routes/ - [F,L,NC]
    RewriteRule ^tests/ - [F,L,NC]
    RewriteRule ^app/ - [F,L,NC]

    # Arahkan semua permintaan ke folder public
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>
